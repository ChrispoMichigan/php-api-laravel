                "parameters": [
                    {
                        "name": "user_id",
                        "in": "path",
                        "description": "ID numérico del usuario (no el username)",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Texto a buscar en handle, title, url o el nombre de la plataforma",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Cantidad de resultados por página (1-100)",
                        "schema": {
                            "type": "integer",
                            "default": 15
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Número de página",
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Listado paginado de enlaces sociales"
                    },
                    "404": {
                        "description": "Usuario no encontrado"
                    }
                }
            },
            "post": {
                "tags": [
                    "User Social Links"
                ],
                "summary": "Agregar un enlace social a un usuario",
                "operationId": "43bf885fd1fd8aefd96847bf06ef00dd",
                "parameters": [
                    {
                        "name": "user_id",
                        "in": "path",
                        "description": "ID numérico del usuario (no el username)",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "social_platform_id",
                                    "url"
                                ],
                                "properties": {
                                    "social_platform_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "url": {
                                        "type": "string",
                                        "example": "https://instagram.com/christian"
                                    },
                                    "handle": {
                                        "type": "string",
                                        "example": "@christian",
                                        "nullable": true
                                    },
                                    "title": {
                                        "type": "string",
                                        "example": "Mi Instagram",
                                        "nullable": true
                                    },
                                    "position": {
                                        "type": "integer",
                                        "example": 0
                                    },
                                    "is_active": {
                                        "type": "boolean",
                                        "example": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Enlace creado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UserSocialLink"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Usuario no encontrado"
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                }
            }
        },
