{
    "openapi": "3.0.0",
    "info": {
        "title": "Linktree API",
        "description": "API REST de ejemplo (CRUD) para un clon de Linktree: usuarios, catálogo de redes sociales y los enlaces sociales de cada usuario.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": "Servidor actual"
        }
    ],
    "paths": {
        "/api/social-platforms": {
            "get": {
                "tags": [
                    "Social Platforms"
                ],
                "summary": "Listar redes sociales del catálogo",
                "description": "Devuelve un listado paginado de plataformas (Instagram, Facebook, etc). Permite buscar por nombre o slug.",
                "operationId": "bc571d223d207e2429e5e39de14ea932",
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Texto a buscar en name o slug",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Cantidad de resultados por página (1-100)",
                        "schema": {
                            "type": "integer",
                            "default": 15
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Número de página",
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Listado paginado de plataformas"
                    }
                }
            },
            "post": {
                "tags": [
                    "Social Platforms"
                ],
                "summary": "Crear una red social en el catálogo",
                "operationId": "05d4bfec6a938dc3350beeda8eb3cab2",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "slug"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Instagram"
                                    },
                                    "slug": {
                                        "type": "string",
                                        "example": "instagram"
                                    },
                                    "base_url": {
                                        "type": "string",
                                        "example": "https://instagram.com/",
                                        "nullable": true
                                    },
                                    "icon": {
                                        "type": "string",
                                        "example": "fa-brands fa-instagram",
                                        "nullable": true
                                    },
                                    "is_active": {
                                        "type": "boolean",
                                        "example": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Plataforma creada",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SocialPlatform"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                }
            }
        },
        "/api/social-platforms/{social_platform_id}": {
            "get": {
                "tags": [
                    "Social Platforms"
                ],
                "summary": "Ver una red social del catálogo",
                "operationId": "f909e0c9ea0698495763599b28086fe9",
                "parameters": [
                    {
                        "name": "social_platform_id",
                        "in": "path",
                        "description": "ID numérico de la plataforma (no el slug)",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Plataforma encontrada",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SocialPlatform"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Plataforma no encontrada"
                    }
                }
            },
            "put": {
                "tags": [
                    "Social Platforms"
                ],
                "summary": "Actualizar una red social del catálogo",
                "operationId": "60250514b6f83ad2c7e84774f4f5bcc7",
                "parameters": [
                    {
                        "name": "social_platform_id",
                        "in": "path",
                        "description": "ID numérico de la plataforma (no el slug)",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Instagram"
                                    },
                                    "slug": {
                                        "type": "string",
                                        "example": "instagram"
                                    },
                                    "base_url": {
                                        "type": "string",
                                        "example": "https://instagram.com/",
                                        "nullable": true
                                    },
                                    "icon": {
                                        "type": "string",
                                        "example": "fa-brands fa-instagram",
                                        "nullable": true
                                    },
                                    "is_active": {
                                        "type": "boolean",
                                        "example": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Plataforma actualizada",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SocialPlatform"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Plataforma no encontrada"
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Social Platforms"
                ],
                "summary": "Eliminar una red social del catálogo",
                "description": "Elimina la plataforma y, en cascada, todos los enlaces de usuarios que la referencian.",
                "operationId": "e96e2501c74938fc6f922abeb71dd709",
                "parameters": [
                    {
                        "name": "social_platform_id",
                        "in": "path",
                        "description": "ID numérico de la plataforma (no el slug)",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Plataforma eliminada"
                    },
                    "404": {
                        "description": "Plataforma no encontrada"
                    }
                }
            }
        },
        "/api/users": {
            "get": {
                "tags": [
                    "Users"
                ],
                "summary": "Listar usuarios",
                "description": "Devuelve un listado paginado de usuarios. Permite buscar por nombre, username o email.",
                "operationId": "566aed8efb436ca506e0ef51a032ecd9",
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Texto a buscar en name, username o email",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Cantidad de resultados por página (1-100)",
                        "schema": {
                            "type": "integer",
                            "default": 15
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Número de página",
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Listado paginado de usuarios"
                    }
                }
