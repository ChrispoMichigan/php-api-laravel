                "parameters": [
                    {
                        "name": "user_id",
                        "in": "path",
                        "description": "ID numérico del usuario (no el username)",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Usuario eliminado"
                    },
                    "404": {
                        "description": "Usuario no encontrado"
                    }
                }
            }
